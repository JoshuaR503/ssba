{
  "provenance": "All values are illustrative simulation assumptions, not measured MasterPi or fab data.",
  "horizon_seconds": 600,
  "poll_interval_seconds": 0.5,
  "temperature_interval_seconds": 5,
  "temperature_warning_c": 75,
  "failure_probability": 0.04,
  "stations": ["ETCH", "DEPOSITION", "METROLOGY"],
  "workload": {
    "arrival_gap_seconds": [4, 8],
    "transfer_seconds": [16, 24],
